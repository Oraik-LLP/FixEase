# FixEase backend — environment variables

# Gemini (diagnosis, VIN OCR)
GEMINI_API_KEY=

# Vehicle RC lookup — Attestr (primary, registration number)
# Docs: https://docs.attestr.com/attestr-docs/vehicle-rc-check-api
# Sign up: https://docs.attestr.com/attestr-docs/attestr-self-signup
ATTESTR_AUTH_TOKEN=
# Or use client credentials (Basic base64 key:secret):
ATTESTR_CLIENT_KEY=
ATTESTR_CLIENT_SECRET=

# Fallback providers (optional)
IDSPAY_API_KEY=
REGCHECK_USERNAME=
