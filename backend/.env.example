# FixEase backend — environment variables

# Gemini (diagnosis, VIN OCR)
GEMINI_API_KEY=

# RevenueCat server-side entitlement verification. Use a secret key only here;
# never include it in the Flutter app or commit it to source control.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT=ENTITLEMENT_PRO
REVENUECAT_EMERGENCY_ENTITLEMENT=ENTITLEMENT_EMERGENCY
REVENUECAT_VERIFICATION_CACHE_MS=300000

# Local development only. Production ignores claimed Pro access unless
# RevenueCat verifies the device-linked App User ID.
ALLOW_UNVERIFIED_PRO_PLAN=false

# Vehicle RC lookup — Attestr (primary, registration number)
# Docs: https://docs.attestr.com/attestr-docs/vehicle-rc-check-api
# Sign up: https://docs.attestr.com/attestr-docs/attestr-self-signup
ATTESTR_AUTH_TOKEN=
# Or use client credentials (Basic base64 key:secret):
ATTESTR_CLIENT_KEY=
ATTESTR_CLIENT_SECRET=

# Fallback providers (optional)
IDSPAY_API_KEY=
REGCHECK_USERNAME=
